# Frontend (used by the Vite app in the browser) — get these from
# Supabase → Project Settings → API. Safe to expose publicly (anon key is
# restricted by the RLS policies in supabase/schema.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Seeding only (never expose this in the browser / commit it) — the service
# role key, used once by `npm run seed` to bulk-load data/events.json.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
